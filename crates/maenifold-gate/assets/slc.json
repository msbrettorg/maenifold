{
  "schemaVersion": 1,
  "id": "slc",
  "name": "Simple, Lovable, Complete",
  "initial": "pending",
  "states": {
    "pending": {
      "on": {
        "pass": "discovery"
      }
    },
    "discovery": {
      "on": {
        "fail": "pending",
        "pass": "spec"
      }
    },
    "spec": {
      "on": {
        "fail": "discovery",
        "pass": "swe"
      }
    },
    "swe": {
      "on": {
        "fail": "spec",
        "pass": "red-team"
      }
    },
    "red-team": {
      "on": {
        "fail": "remediate",
        "pass": "blue-team"
      }
    },
    "remediate": {
      "on": {
        "fail": "spec",
        "pass": "red-team"
      }
    },
    "blue-team": {
      "on": {
        "fail": "remediate",
        "pass": "done"
      }
    },
    "done": {
      "terminal": true
    }
  }
}
