{
  "schemaVersion": 1,
  "id": "sdd-c",
  "name": "Spec Driven Development (with Confessions)",
  "initial": "pending",
  "states": {
    "pending": {
      "on": {
        "pass": "swe"
      }
    },
    "swe": {
      "on": {
        "fail": "pending",
        "pass": "swe-confess"
      }
    },
    "swe-confess": {
      "on": {
        "fail": "swe",
        "pass": "red-team"
      }
    },
    "red-team": {
      "on": {
        "fail": "pending",
        "pass": "red-team-confess"
      }
    },
    "red-team-confess": {
      "on": {
        "fail": "red-team",
        "pass": "blue-team"
      }
    },
    "blue-team": {
      "on": {
        "fail": "pending",
        "pass": "blue-team-confess"
      }
    },
    "blue-team-confess": {
      "on": {
        "fail": "blue-team",
        "pass": "pm-confess"
      }
    },
    "pm-confess": {
      "on": {
        "fail": "pending",
        "pass": "red-team-audit"
      }
    },
    "red-team-audit": {
      "on": {
        "fail": "pending",
        "pass": "done"
      }
    },
    "done": {
      "terminal": true
    }
  }
}
