{
  "schemaVersion": 1,
  "id": "mdd",
  "name": "Model Driven Development",
  "initial": "pending",
  "states": {
    "pending": {
      "on": {
        "pass": "opus-plan"
      }
    },
    "opus-plan": {
      "on": {
        "pass": "goldeneye-plan-review"
      }
    },
    "goldeneye-plan-review": {
      "on": {
        "pass": "gpt-5.4-test-writing",
        "fail": "opus-plan"
      }
    },
    "gpt-5.4-test-writing": {
      "on": {
        "pass": "gpt-5.4-implementation",
        "fail": "opus-plan"
      }
    },
    "gpt-5.4-implementation": {
      "on": {
        "pass": "gpt-5.4-test-execution",
        "fail": "opus-plan"
      }
    },
    "gpt-5.4-test-execution": {
      "on": {
        "pass": "goldeneye-work-review",
        "fail": "gpt-5.4-implementation"
      }
    },
    "goldeneye-work-review": {
      "on": {
        "pass": "opus-acceptance",
        "fail": "pending"
      }
    },
    "opus-acceptance": {
      "on": {
        "pass": "done",
        "fail": "pending"
      }
    },
    "done": {
      "terminal": true
    }
  }
}
