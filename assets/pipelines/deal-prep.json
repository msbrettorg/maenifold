{
  "_comment": "Deal-prep pipeline — typed-handoff form (T-332 + T-334.1 + T-334.2). 10 nodes, 23 binding edges, all 4 node types. Parameterizable via top-level inputs. Layer-1 tool nodes use maenifold-native gateway calls; original workiq/msx/ms-docs were dropped because those MCP servers are not wired into any ACP agent in this env. Wire them into Copilot's MCP config and re-introduce by adding tool nodes pointed at those toolNames. crta is a workflow node using the crta workflow asset (9-step CRTA methodology with sequential thinking) — requires T-334.1 workflow-node typed-handoff fix to capture structured output. Long-prompt crta agent may emit JSON-as-text instead of complete_node call — requires T-334.2 fenced_json_fallback safety net.",
  "inputs": {
    "customer_name": "Oracle Corporation",
    "customer_folder": "work/customers/oracle/licensing",
    "topic_query": "Oracle SCE licensing optimization Azure",
    "concept_anchor": "Oracle",
    "output_dir": "/Users/brett/maenifold/output"
  },
  "nodes": [
    {
      "id": "graph-search",
      "type": "tool",
      "displayLabel": "Hybrid memory search",
      "toolName": "GatewayExecute",
      "toolArgs": {
        "domain": "maenifold.memory",
        "command": "SearchMemories",
        "parameters": {
          "query": "{{ inputs.customer_name }} {{ inputs.topic_query }}",
          "mode": "Hybrid",
          "pageSize": 5
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "string" } }
      }
    },
    {
      "id": "concept-graph",
      "type": "tool",
      "displayLabel": "Concept neighborhood",
      "toolName": "GatewayExecute",
      "toolArgs": {
        "domain": "maenifold.graph",
        "command": "BuildContext",
        "parameters": {
          "conceptName": "{{ inputs.concept_anchor }}",
          "depth": 1,
          "includeContent": false
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "string" } }
      }
    },
    {
      "id": "recent-activity",
      "type": "tool",
      "displayLabel": "Recent activity in graph",
      "toolName": "GatewayExecute",
      "toolArgs": {
        "domain": "maenifold.system",
        "command": "RecentActivity",
        "parameters": {
          "filter": "memory",
          "limit": 8
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "string" } }
      }
    },
    {
      "id": "customer-folder",
      "type": "tool",
      "displayLabel": "Customer-scoped search",
      "toolName": "GatewayExecute",
      "toolArgs": {
        "domain": "maenifold.memory",
        "command": "SearchMemories",
        "parameters": {
          "query": "{{ inputs.customer_name }} licensing CRTA assessment briefing analysis",
          "mode": "Hybrid",
          "pageSize": 5
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "string" } }
      }
    },
    {
      "id": "pattern-search",
      "type": "tool",
      "displayLabel": "Reusable pattern search",
      "toolName": "GatewayExecute",
      "toolArgs": {
        "domain": "maenifold.memory",
        "command": "SearchMemories",
        "parameters": {
          "query": "{{ inputs.topic_query }} pattern reusable",
          "mode": "Hybrid",
          "pageSize": 4
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "string" } }
      }
    },
    {
      "id": "similar-concepts",
      "type": "tool",
      "displayLabel": "Similar concept discovery",
      "toolName": "GatewayExecute",
      "toolArgs": {
        "domain": "maenifold.graph",
        "command": "FindSimilarConcepts",
        "parameters": {
          "conceptName": "{{ inputs.concept_anchor }}",
          "maxResults": 6
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "string" } }
      }
    },
    {
      "id": "crta",
      "type": "workflow",
      "displayLabel": "CRTA — Compelling Reason to Act",
      "workflowId": "crta",
      "acpClient": "Copilot",
      "prompt": "Run the CRTA (Compelling Reason to Act) workflow methodology against intelligence about {{ inputs.customer_name }}. Evidence base in runtime_inputs: graph_search, concept_graph, recent_activity, customer_folder, pattern_search, similar_concepts. Apply the workflow's 9-step methodology end to end. When you reach the final synthesis step, return ONLY this JSON object (via complete_node tool call if available, or as raw JSON content), with no markdown wrapper: {\"crta_analysis\": \"<full 6-section markdown analysis: current state, desired state, gap, consequences, recommended action, timeline>\", \"compelling_reason\": \"<single sentence>\"}",
      "inputSchema": {
        "type": "object",
        "required": ["graph_search", "concept_graph", "recent_activity", "customer_folder", "pattern_search", "similar_concepts"],
        "properties": {
          "graph_search": { "type": "string" },
          "concept_graph": { "type": "string" },
          "recent_activity": { "type": "string" },
          "customer_folder": { "type": "string" },
          "pattern_search": { "type": "string" },
          "similar_concepts": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["crta_analysis", "compelling_reason"],
        "properties": {
          "crta_analysis": { "type": "string" },
          "compelling_reason": { "type": "string" }
        }
      }
    },
    {
      "id": "synthesis",
      "type": "sequentialThinking",
      "displayLabel": "Slide-by-slide synthesis (4 thoughts)",
      "agent": "Copilot",
      "model": "gpt-5.5",
      "topic": "Synthesize a slide-by-slide deck specification for a customer-facing deal-prep presentation about {{ inputs.customer_name }}. You have all Layer-1 intelligence in runtime_inputs (graph_search, concept_graph, recent_activity, customer_folder, pattern_search, similar_concepts) plus runtime_inputs.crta_analysis and runtime_inputs.compelling_reason from the CRTA node. Work through 4 thoughts: (1) audience + narrative arc, (2) slide breakdown with titles, (3) per-slide bullet content, (4) visual/data recommendations. Return ONLY this JSON object (via complete_node or as raw JSON content), with no markdown wrapper: {\"deck_spec\": \"<full slide-by-slide markdown spec with titles, bullets, visuals>\", \"slide_count\": <integer>}",
      "totalThoughts": 4,
      "inputSchema": {
        "type": "object",
        "required": ["graph_search", "concept_graph", "recent_activity", "customer_folder", "pattern_search", "similar_concepts", "crta_analysis", "compelling_reason"],
        "properties": {
          "graph_search": { "type": "string" },
          "concept_graph": { "type": "string" },
          "recent_activity": { "type": "string" },
          "customer_folder": { "type": "string" },
          "pattern_search": { "type": "string" },
          "similar_concepts": { "type": "string" },
          "crta_analysis": { "type": "string" },
          "compelling_reason": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["deck_spec", "slide_count"],
        "properties": {
          "deck_spec": { "type": "string" },
          "slide_count": { "type": "integer" }
        }
      },
      "toolMode": "auto"
    },
    {
      "id": "validate-spec",
      "type": "workflow",
      "displayLabel": "Validate deck spec (workflow-dispatch)",
      "workflowId": "workflow-dispatch",
      "acpClient": "Copilot",
      "prompt": "Validate the deck spec for {{ inputs.customer_name }}. Read runtime_inputs.deck_spec, runtime_inputs.slide_count, runtime_inputs.crta_analysis, runtime_inputs.compelling_reason. Check that the spec covers the compelling reason, all 6 CRTA sections are reflected, slide count matches, and every slide has clear title + bullets + visual recommendation. Return ONLY this JSON object (via complete_node or as raw JSON content), with no markdown wrapper: {\"validated_deck_spec\": \"<deck_spec verbatim if valid, OR corrected version if you fixed gaps>\", \"slide_count\": <integer>, \"validation_notes\": \"<one paragraph of what you checked and any corrections made>\"}",
      "inputSchema": {
        "type": "object",
        "required": ["deck_spec", "slide_count", "crta_analysis", "compelling_reason"],
        "properties": {
          "deck_spec": { "type": "string" },
          "slide_count": { "type": "integer" },
          "crta_analysis": { "type": "string" },
          "compelling_reason": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["validated_deck_spec", "slide_count", "validation_notes"],
        "properties": {
          "validated_deck_spec": { "type": "string" },
          "slide_count": { "type": "integer" },
          "validation_notes": { "type": "string" }
        }
      }
    },
    {
      "id": "deck-gen",
      "type": "prompt",
      "displayLabel": "Generate PPTX + PDF",
      "agent": "Copilot",
      "model": "gpt-5.5",
      "maxTurns": 15,
      "prompt": "Generate a PowerPoint deck for {{ inputs.customer_name }}. Primary inputs: runtime_inputs.validated_deck_spec (slide-by-slide spec), runtime_inputs.slide_count (target count), runtime_inputs.crta_analysis (analytical backbone), runtime_inputs.compelling_reason (opening hook), runtime_inputs.validation_notes (any validator-recommended adjustments). Raw Layer-1 evidence is also available in runtime_inputs.graph_search, concept_graph, recent_activity, customer_folder, pattern_search, similar_concepts — consult these only when the spec needs additional grounding. Write python-pptx code, execute it, and produce two artifacts in {{ inputs.output_dir }}/: a .pptx and a .pdf (LibreOffice headless export). Use the 2x text-box-height rule to prevent wrapping overlaps. After both files exist, return ONLY this JSON object (via complete_node or as raw JSON content), with no markdown wrapper: {\"pptx_path\": \"<absolute path>\", \"pdf_path\": \"<absolute path>\", \"slide_count\": <integer>, \"customer\": \"{{ inputs.customer_name }}\"}",
      "inputSchema": {
        "type": "object",
        "required": ["validated_deck_spec", "slide_count", "validation_notes", "crta_analysis", "compelling_reason", "graph_search", "concept_graph", "recent_activity", "customer_folder", "pattern_search", "similar_concepts"],
        "properties": {
          "validated_deck_spec": { "type": "string" },
          "slide_count": { "type": "integer" },
          "validation_notes": { "type": "string" },
          "crta_analysis": { "type": "string" },
          "compelling_reason": { "type": "string" },
          "graph_search": { "type": "string" },
          "concept_graph": { "type": "string" },
          "recent_activity": { "type": "string" },
          "customer_folder": { "type": "string" },
          "pattern_search": { "type": "string" },
          "similar_concepts": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["pptx_path", "pdf_path", "slide_count", "customer"],
        "properties": {
          "pptx_path": { "type": "string" },
          "pdf_path": { "type": "string" },
          "slide_count": { "type": "integer" },
          "customer": { "type": "string" }
        }
      },
      "toolMode": "auto"
    }
  ],
  "edges": [
    { "source": "graph-search",      "target": "crta",          "type": "success", "mode": "binding", "mapping": { "inputs.graph_search": "data" } },
    { "source": "concept-graph",     "target": "crta",          "type": "success", "mode": "binding", "mapping": { "inputs.concept_graph": "data" } },
    { "source": "recent-activity",   "target": "crta",          "type": "success", "mode": "binding", "mapping": { "inputs.recent_activity": "data" } },
    { "source": "customer-folder",   "target": "crta",          "type": "success", "mode": "binding", "mapping": { "inputs.customer_folder": "data" } },
    { "source": "pattern-search",    "target": "crta",          "type": "success", "mode": "binding", "mapping": { "inputs.pattern_search": "data" } },
    { "source": "similar-concepts",  "target": "crta",          "type": "success", "mode": "binding", "mapping": { "inputs.similar_concepts": "data" } },

    { "source": "graph-search",      "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.graph_search": "data" } },
    { "source": "concept-graph",     "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.concept_graph": "data" } },
    { "source": "recent-activity",   "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.recent_activity": "data" } },
    { "source": "customer-folder",   "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.customer_folder": "data" } },
    { "source": "pattern-search",    "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.pattern_search": "data" } },
    { "source": "similar-concepts",  "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.similar_concepts": "data" } },
    { "source": "crta",              "target": "synthesis",     "type": "success", "mode": "binding", "mapping": { "inputs.crta_analysis": "crta_analysis", "inputs.compelling_reason": "compelling_reason" } },

    { "source": "graph-search",      "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.graph_search": "data" } },
    { "source": "concept-graph",     "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.concept_graph": "data" } },
    { "source": "recent-activity",   "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.recent_activity": "data" } },
    { "source": "customer-folder",   "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.customer_folder": "data" } },
    { "source": "pattern-search",    "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.pattern_search": "data" } },
    { "source": "similar-concepts",  "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.similar_concepts": "data" } },
    { "source": "crta",              "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.crta_analysis": "crta_analysis", "inputs.compelling_reason": "compelling_reason" } },
    { "source": "synthesis",         "target": "validate-spec", "type": "success", "mode": "binding", "mapping": { "inputs.deck_spec": "deck_spec", "inputs.slide_count": "slide_count" } },
    { "source": "crta",              "target": "validate-spec", "type": "success", "mode": "binding", "mapping": { "inputs.crta_analysis": "crta_analysis", "inputs.compelling_reason": "compelling_reason" } },
    { "source": "validate-spec",     "target": "deck-gen",      "type": "success", "mode": "binding", "mapping": { "inputs.validated_deck_spec": "validated_deck_spec", "inputs.slide_count": "slide_count", "inputs.validation_notes": "validation_notes" } }
  ]
}
