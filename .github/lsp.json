{
  "lspServers": {
    "rust-analyzer": {
      "command": "rust-analyzer",
      "args": [],
      "initializationTimeoutMs": 180000,
      "fileExtensions": {
        ".rs": "rust"
      }
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "rootUri": "apps/desktop",
      "initializationOptions": {
        "tsserver": {
          "path": "node_modules/typescript/lib"
        }
      },
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript",
        ".mts": "typescript",
        ".cts": "typescript"
      }
    },
    "vue": {
      "command": "vue-language-server",
      "args": ["--stdio"],
      "rootUri": "apps/desktop",
      "requestTimeoutMs": 180000,
      "initializationOptions": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        },
        "vue": {
          "hybridMode": false
        }
      },
      "fileExtensions": {
        ".vue": "vue"
      }
    }
  }
}
